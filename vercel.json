{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/brochure", "destination": "/brochure-aysa.pdf" },
    { "source": "/brochure.pdf", "destination": "/brochure-aysa.pdf" }
  ],
  "headers": [
    {
      "source": "/(brochure|brochure.pdf|brochure-aysa.pdf)",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=\"Brochure-AYSA.pdf\"" }
      ]
    }
  ]
}
